// File name: projects/01/Mux.hdl

/** 
 * Multiplexor:
 * out = a if sel == 0
 *       b otherwise
 */

CHIP Mux {
    IN a, b, sel;
    OUT out;

    PARTS:
    Nand(a=a, b=sel, out = c);
    Nand(a=sel, b=sel, out = d);
    Nand(a=d, b=b, out = e);
    Nand(a=c, b=e, out=out);
}