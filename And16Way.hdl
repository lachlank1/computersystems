// File name: And16Way.hdl

/**
 * 16-way And: 
 * out = (in[0] and in[1] and ... and in[15])
 */

CHIP And16Way {
    IN in[16];
    OUT out;

    PARTS:
	And(a=in[0], b=in[1], out=q);
	And(a=in[2], b=in[3], out=r);
	And(a=in[4], b=in[5], out=s);
	And(a=in[6], b=in[7], out=t);
	And(a=in[8], b=in[9], out=u);
	And(a=in[10], b=in[11], out=v);
	And(a=in[12], b=in[13], out=w);
	And(a=in[14], b=in[15], out=x);
	And(a=q, b=r, out=c1);
	And(a=s, b=t, out=c2);
	And(a=u, b=v, out=c3);
	And(a=w, b=x, out=c4);
	And(a=c1, b=c2, out=d1);
	And(a=c3, b=c4, out=d2);
	And(a=d1, b=d2, out=out);
}